#!/bin/bash
# Copyright (C) 2026 Zoran Loncarevic

arg0=${0##*/}
: "${CHEZPAGER:=less -FR}"
: "${REPOSITORY_DIR:=$HOME/Projects/Chez/Repository}"
excluded_files=( "!" "-path" "*/.git/*")
[[ -t 0 && -t 1 ]] &&
  connected_to_terminal="yes" ||
  connected_to_terminal="no"

function usage() {
  echo "Usage: $arg0 [options] command ..."
  exit 0
}

function version() {
  echo "$arg0 version 0.1"
  exit 0
}

function perror() {
  echo $1
  if [[ "$2" != "non-fatal" ]]; then
    exit 1
  fi
}

function verbose_message()
{
  if [[ "$option_verbose" == "yes" ]]; then
    echo "+$1"
  fi
}

function invoke_pager_if_on_terminal()
{
  if [[ "$connected_to_terminal" == yes ]]; then
    $CHEZPAGER
  else
    cat
  fi
}

function save_options()
{
  local option_var
  while [[ $# -gt 0 ]]; do
    option_var="option_$1"
    printf -v "saved_$option_var" "%s" "${!option_var}"
    shift
  done
}

function restore_options()
{
  local option_var
  while [[ $# -gt 0 ]]; do
    option_var="saved_option_$1"
    printf -v "option_$1" "%s" "${!option_var}"
    shift
  done
}

function is_this_a_dry_run()
{
  [[ "$option_dry_run" == "yes" ]]
}

function system_to_repository()
{
  local repository=${1/#$HOME//HOME}

  repository=${repository///dot_//literal_dot_}
  repository=${repository///.//dot_}
  local part1=${repository%/*}
  local part2=${repository##*/}
  part2=${part2/#exec_/literal_exec_}
  part2=${part2/#link_/literal_link_}
  part2=${part2/#template_/literal_template_}

  echo "$part1/$part2"
}

function repository_to_system()
{
  local system=${1#$REPOSITORY_DIR/Files}

  system=${system/#\/HOME\//$HOME\/}
  system=${system///dot_//.}

  local part1=${system%/*}
  local part2=${system##*/}
  part2=${part2#exec_modify_}
  part2=${part2#exec_no-output_}
  part2=${part2#exec_literal_}
  part2=${part2#exec_}
  part2=${part2#link_}
  part2=${part2#template_}
  system="$part1/$part2"

  system=${system///literal_//}
  echo $system
}

function remove_element_from_array()
{
  local -n _array=$1
  local new_array=()

  for item in "${_array[@]}"; do
    if [[ "$item" != "$2" ]]; then
      new_array+=("$item")
    fi
  done
  _array=("${new_array[@]}")
}

function slurp_options_from_filename()
{
  local basename=${1##*/}
  case "$basename" in
    exec_modify_*)
      option_exec="modify"    ;;
    exec_no-output_*)
      option_exec="no-output" ;;
    exec_*)
      option_exec="yes"       ;;
    template_*)
      option_exec="template"  ;;
    link_*)
      option_link="yes"       ;;
  esac

  [[ "$option_exec" == "modify" ]] && option_overwrite="yes"
}

function for_each_found_file_with_filtering_do()
{
  local callback=$1
  shift

  while IFS= read -r file; do
    "$callback" "$file"
  done < <(find "$@" | filter_list_of_files)
}

function for_each_found_file_do()
{
  local callback=$1
  shift

  local print0="-print0"
  [[ "${!#}" == "+" ]] && print0=""

  while IFS= read -r -d '' file; do
    "$callback" "$file"
  done < <(find "$@" $print0)
}

function add_filter_attributes()
{
  if (( ${#filters[@]} > 0 )); then
    declare -A union_map
    for i in "${relevant_attributes[@]}" "${!filters[@]}"; do
      union_map["$i"]=1
    done
    relevant_attributes=("${!union_map[@]}")
  fi
}

function is_filtered()
{
  if (( ${#excludes[@]} > 0 )); then
    local filter
    for filter in "${excludes[@]}"; do
      if [[ "$1" == $filter ]]; then
	return 0
      fi
    done
  fi

  if (( ${#filters[@]} > 0 )); then
    local attr
    for attr in "${!filters[@]}"; do
      local option_attr="option_$attr"
      if [[ "${!option_attr}" != "${filters["$attr"]}" && -z "${negations["$attr"]}" ]] ||
	 [[ "${!option_attr}" == "${filters["$attr"]}" && -n "${negations["$attr"]}" ]]; then
	return 0
      fi
    done
  fi

  return 1
}

function for_each_found_file_with_options_slurped_do()
{
  local file attribute value line
  local prev_file=""
  local failure_cnt=0

  local callback=$1
  shift

  [[ -z "$relevant_attributes" ]] &&
  local relevant_attributes=(symbolic sudo deferred permission owner link overwrite exec test)
  add_filter_attributes
  save_options "${relevant_attributes[@]}"

  local excluded_files="! -name .gitkeep ! -name .gitattributes"
  find "$@" $excluded_files |
  git -C "${REPOSITORY_DIR}" check-attr --stdin "${relevant_attributes[@]}" |
  ( while IFS=: read -r line; do
      # Split the line we read into fields using ':' as delimiter
      value="${line##*: }"
      line="${line%:*}"
      attribute="${line##*: }"
      file="${line%:*}"

      if [[ "$file" != "$prev_file" && ! -z "$prev_file" ]]; then
	slurp_options_from_filename "$prev_file"
	if ! is_filtered "$prev_file"; then
	  "$callback" "$prev_file" || (( ++failure_cnt ))
	fi
        restore_options "${relevant_attributes[@]}"
      fi

      prev_file=$file
      option_variable=option_$attribute
      if [[ -z "${!option_variable}" ]]; then
	if [[ "$value" == "set" ]]; then
	  printf -v "$option_variable" "yes"
	elif [[ "$value" != "unset" && "$value" != "unspecified" ]]; then
	  printf -v "$option_variable" "$value"
	fi
      fi
    done
    slurp_options_from_filename "$prev_file"
    if ! is_filtered "$prev_file"; then
      "$callback" "$prev_file" || (( ++failure_cnt ))
    fi
    (( failure_cnt == 0 ))
    exit $? )
  return $?
}

function get_cli_arg_as_repository_path()
{
  local expanded_path=${1/#:/$REPOSITORY_DIR/Groups/}
        expanded_path=$(realpath -s -- "$expanded_path")

  if [[ "$expanded_path" != "$REPOSITORY_DIR"* ]]; then
    expanded_path=${REPOSITORY_DIR}/Files$(system_to_repository "$expanded_path")
  fi

  echo "$expanded_path"
  [[ -e "$expanded_path" ]]
}

function diff_single_pair()
{
  [[ -z "$1" ]] && return
  [[ -n "$defer_mechanism_activated" && "$option_deferred" == "yes" ]] && return
  local system=$(repository_to_system "$1")
  local repository=$1
  local require_cleanup=""
  if [[ ! -e "$system" ]]; then
    echo -e "\e[1mDoes not exist: $system\e[m"
    return 0
  fi
  if [[ -h "$system" && "$(realpath -- "$system")" == "$1" ]]; then
    return 0
  fi
  if [[ -n "$option_exec" ]]; then
    [[ "$option_exec" == "no-output" ]] && return 0
    local mode=$script_mode
    if [[ "$option_exec" == "template" && -n "$template_mode" ]]; then
      mode=$template_mode
    fi
    case "$mode" in
      none) return 0 ;;
      source) :      ;;
      output)
	repository=$(mktemp) || return 0
	require_cleanup="yes"
	[[ -x "$1" ]] || chmod +x "$1" || return 0
	case "$option_exec" in
	  template) ;&
	  yes) "$1" > "$repository" ;;
	  modify)
	    if [[ -f "$system" ]]; then
	      "$1" < "$system" > "$repository"
	    else
	      "$1" < /dev/null > "$repository"
	    fi ;;
	esac
    esac
  fi
  
  local rep_regex=${REPOSITORY_DIR#/}
  rep_regex=${rep_regex//\//\\\/}
  if [[ -z "$option_link" ]]; then
    git diff "${diff_options[@]}" --no-index --no-prefix --color=$color -- "$system" "$repository"
  else
    git diff "${diff_options[@]}" --no-index --no-prefix --color=$color -- - "$repository" <<< \
	     "$(readlink "$system" || echo '[Not a symbolic link]')"
  fi |
  sed '/^\(\o033\[1m\)\?diff --git/s| '"$rep_regex"'\/Files\/[^\o033]*||
       /^\(\o033\[1m\)\?diff --git/s|\(diff --git [^ ]*\) [^\o033]*|\1|
       /^\(\o033\[1m\)\?diff --git/s|diff --git -|diff --git '"$system [as symbolic link]"'|
       /^\(\o033\[1m\)\?+++ /s| [^\o033]*| Repository|
       /^\(\o033\[1m\)\?--- -/s|--- -|--- '"$system"'|'
  if [[ "$require_cleanup" == "yes" ]]; then
    rm "$repository"
  fi
}

function command_diff()
{
  local our_args=()
  local diff_args=()
  local did_some_paths=""

  local filter_value_plus="yes"
  local filter_value_minus=""

  shift
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    our_args+=("$1")
    shift
  done
  shift
  local diff_options=("$@")

  declare -A filters negations
  local excludes=()
  local keep_the_same_filters=""
  collect_exclude_options "${our_args[@]}"
  local relevant_attributes=(link exec deferred)

  local template_mode=""
  local script_mode="none"
  local option_all=""

  local color="auto"
  [[ "$connected_to_terminal" == "yes" ]] && color="always"

  set -- "${our_args[@]}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --filter)
	shift
	add_filter "$1" ;;
      --exclude)
	shift             ;;
      -g|--global)
	keep_the_same_filters="yes" ;;
      --template=none)
	template_mode="none"        ;;
      --template=source)
        template_mode="source"      ;;
      --template=output)
        template_mode="output"      ;;
      --script=none)
	script_mode="none"          ;;
      --script=source)
	script_mode="source"        ;;
      --script=output)
	script_mode="output"        ;;
      -a|--all)
	option_all="yes"            ;;
      *)
	local path=$(get_cli_arg_as_repository_path "$1")
	if [[ ! -e "$path" ]]; then
	  perror "$1 does not exist in repository"
	fi

	did_some_paths="yes"
	if [[ "$path" == "$REPOSITORY_DIR/Groups/"* ]]; then
	  if [[ -d "$path" ]]; then
	    for_each_found_file_with_options_slurped_do diff_single_pair "$path" -type l -exec readlink -z -f {} +
	  elif [[ -h "$path" ]]; then
	    for_each_found_file_with_options_slurped_do diff_single_pair "$(realpath -- $path)"
	  fi
	else
	  if [[ "$option_all" != "yes" ]] && ! is_deferred_set_for "$path"; then
	    local defer_mechanism_activated="yes"
	  fi
	  local excluded_files="! -name .gitkeep ! -name .gitattributes"
	  for_each_found_file_with_options_slurped_do diff_single_pair "$path" -type f $excluded_files
	fi ;;
    esac
    shift
  done
  if [[ -z "$did_some_paths" ]]; then
    [[ "$option_all" != "yes" ]] &&
    local defer_mechanism_activated="yes"
    local excluded_files="! -name .gitkeep ! -name .gitattributes"
    for_each_found_file_with_options_slurped_do diff_single_pair "$REPOSITORY_DIR/Files" -type f $excluded_files
  fi
  exit
}

function get_option_from_filename()
{
  local option_exec option_link "option_$1"
  local option_var="option_$1"
  printf -v "$option_var" ""
  slurp_options_from_filename "$3"
  local result=${!option_var}
  [[ -n "$result" ]]           &&
    echo "${result/yes/set}"   ||
    echo "$2"
}

function filter_list_of_files()
{
  {
    if (( ${#excludes[@]} == 0 )); then
      sed "\|${REPOSITORY_DIR}|! s|^|Files/|"
    else
      local file
      while IFS= read -r file; do
	local filter
	for filter in "${excludes[@]}"; do
	  if [[ "$file" == $filter ]]; then
	    continue 2
	  fi
	done
	if [[ "$file" == "${REPOSITORY_DIR}"* ]]; then
	  echo "$file"
	else
	  echo "Files/$file"
	fi
      done
    fi
  } |
  {
    if (( ${#filters[@]} == 0 )); then
      sed 's|^Files/||'
    else
      local prev_file="" reject=""
      local value line attribute file
      git -C "${REPOSITORY_DIR}" check-attr --stdin "${!filters[@]}" |
      while IFS=: read -r line; do
	# Split the line we read into fields using ':' as delimiter
	value="${line##*: }"
	line="${line%:*}"
	attribute="${line##*: }"
	file="${line%:*}"
	value="$(get_option_from_filename "$attribute" "$value" "$file")"

	if [[ "$file" != "$prev_file" && ! -z "$prev_file" ]]; then
	  if [[ -z "$reject" ]]; then
	    echo "${prev_file#File/}"
	  else
	    reject=""
	  fi
	fi

	prev_file=$file
	if [[ "$value" != "${filters["$attribute"]}" && -z "${negations["$attribute"]}" ]] ||
	   [[ "$value" == "${filters["$attribute"]}" && -n "${negations["$attribute"]}" ]]; then
	  reject="yes"
	fi
      done
      [[ -z "$reject" && -n $prev_file ]] &&
	echo "${prev_file#File/}"
    fi
  } |
  {
    if [[ -z "$print_directories" ]]; then
      cat
    else
      sed 's|\/[^\/]*$||' |
      sort |
      uniq
    fi
  }
}

function command_ls-files_check_options()
{
  expanded_arguments=("$1")
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--cached)   ;&
      -m|--modified) ;&
      -o|--other)    ;&
      -d|--deleted)  ;&
      --directory)   ;&
      -g|--global) : ;;
      -f|--filter)
	expanded_arguments+=("$1")
	shift        ;;
      -e|--exclude)
	expanded_arguments+=("$1")
	shift        ;;
      -*)
	if [[ "$1" == -[^-][^-]* ]]; then
	  for (( i=1; i<${#1}; i++ )); do
	    expanded_arguments+=("-${1:i:1}")
	  done
	  shift ; continue
	else
	  perror "unknown option $1"
	fi ;;
    esac
    expanded_arguments+=("$1")
    shift
  done
}

function list_repository_files()
{
  local path=$1
  if [[ -n "$path" ]]; then
    path="$(get_cli_arg_as_repository_path "$path")"
    path="${path#$REPOSITORY_DIR/Files/}"
  fi

  {
    if [[ "$path" == "$REPOSITORY_DIR/Groups/"* ]]; then
      find "$path" -type l -exec readlink -f {} + |
	sed "s|$REPOSITORY_DIR/Files/||"
    elif [ ${#ls_files_options[@]} -eq 0 ]; then
      find "$REPOSITORY_DIR/Files/$path" -type f ! -name .gitkeep ! -name .gitattributes |
	sed "s|$REPOSITORY_DIR/Files/||"
    else
      git -C "$REPOSITORY_DIR" ls-files "${ls_files_options[@]}" "Files/$path" |
	sed "/.gitkeep$/d
	     /.gitattributes/d
	     s|Files/||"
    fi
  } |
  filter_list_of_files
}

function collect_exclude_options()
{
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e|--exclude)
	shift
	excludes+=("$1")
    esac
    shift
  done
}

function add_filter()
{
  local attr value
  local list_of_filters="$1,"
  while [[ -n "$list_of_filters" ]]; do
    local negation=""
    local filter=${list_of_filters%%,*}
    list_of_filters="${list_of_filters#*,}"
    case "$filter" in
      *!=*)
	negation="yes"
	attr="${filter%!=*}"
	value="${filter#*!=}" ;;
      *=*)
	attr="${filter%=*}"
	value="${filter#*=}" ;;
      +*)
	attr="${filter#+}"
	value=$filter_value_plus  ;;
      -*)
	attr="${filter#-}"
	value=$filter_value_minus ;;
      *)
	perror "invalid filter: $filter" non-fatal
	return 1
    esac
    filters["$attr"]="$value"
    [[ -n "$negation" ]] && negations["$attr"]="yes" || negations["$attr"]=""
  done
}

function command_ls-files()
{
  declare -A filters negations
  local excludes=()
  local ls_files_options=()
  local keep_the_same_filters=""
  local print_directories=""
  local did_some_paths=""

  local filter_value_plus="set"
  local filter_value_minus="unset"

  command_ls-files_check_options "$@"
  set -- "${expanded_arguments[@]}"

  shift
  collect_exclude_options "$@"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--cached)   ;&
      -m|--modified) ;&
      -o|--other)    ;&
      -d|--deleted)
	ls_files_options+=("$1") ;;
      -f|--filter)
	shift
	add_filter "$1" ;;
      -e|--exclude)
	shift           ;;
      -g|--global)
	keep_the_same_filters="yes" ;;
      --directory)
	print_directories="yes"     ;;
      *)
	did_some_paths="yes"
	list_repository_files "$1"
	if [[ -z "$keep_the_same_filters" ]]; then
	  filters=()
	  negations=()
	fi ;;
    esac
    shift
  done

  if [[ -z "$did_some_paths" ]]; then
    list_repository_files
  fi
  exit
}

function command_get_repository_path()
{
  shift
  if [[ $# -eq 0 ]]; then
    echo "$(get_cli_arg_as_repository_path /)"
  else
    while [[ $# -gt 0 ]]; do
      echo "$(get_cli_arg_as_repository_path "$1")"
      shift
    done
  fi
  exit 0
}

function command_cd()
{
  shift
  local directory=""
  local cd_method="file"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e) cd_method="exec" ;;
       *) directory="$1"   ;;
    esac
    shift
  done

  [[ -z "$directory" ]] && directory=$HOME
  local path=$(get_cli_arg_as_repository_path "$directory")
  if [[ -f "$path" ]]; then
    path=${path%/*}
  fi

  if [[ "$cd_method" == "file" ]]; then
    : ${CDFILEPATH:=$HOME/.chezcdpath}
    echo "cd $path" > "$CDFILEPATH"
  else
    ( cd "$path"
      "$SHELL" )
  fi
  exit 0
}

function command_edit()
{
  shift
  local paths=()
  while [[ $# -gt 0 ]]; do
    paths+=("$(get_cli_arg_as_repository_path "$1")")
    shift
  done

  local SELECTED_EDITOR="${VISUAL:${EDITOR:-vi}}"
  if ! command -v "$SELECTED_EDITOR" >/dev/null 2>&1; then
    echo "Error: Configured editor '$SELECTED_EDITOR' not found."
    SELECTED_EDITOR="vi"
    echo "Falling back to: $SELECTED_EDITOR"
  fi

  if (( ${#paths[@]} == 0 )); then
    "$SELECTED_EDITOR" "$(get_cli_arg_as_repository_path "/")"
  else
    "$SELECTED_EDITOR" "${paths[@]}"
  fi
  exit
}

function command_git()
{
  git -C "${REPOSITORY_DIR}" "$@"
  exit 0
}

function expand_group_path()
{
  local path=${1/#:/$REPOSITORY_DIR/Groups/}
  path=$(realpath -s -- "$path")

  if [[ "$path" != "$REPOSITORY_DIR/Groups/"* ]]; then
    perror "$path is not a Groups directory"
  fi
  
  echo "$path"
}

function update_source_link_for_mv()
{
  ln -sfn "$(readlink -f "$1")" "$1"
}

function update_dest_link_for_mv()
{
  ln -sfnr "$(readlink -f "$1")" "$1"
}

function mv_group()
{
  verbose_message "Moving ${1/#$REPOSITORY_DIR\/Groups\//:} to" \
                         "${2/#$REPOSITORY_DIR\/Groups\//:}"
  if is_this_a_dry_run; then
    return 0
  fi

  if [[ ! -e "$1" ]]; then
    perror "$1: does not exist" non-fatal
    return 1
  fi

  for_each_found_file_do update_source_link_for_mv "$1" -type l
  mv "$1" "$2" ||
  {
    for_each_found_file_do update_dest_link_for_mv "$1" -type l
    return 1
  }
  for_each_found_file_do update_dest_link_for_mv "$2" -type l
}

function command_mv()
{
  local src dest exit_code=0

  shift
  if [[ $# -lt 2 ]]; then
    perror "$0 mv: missing source or destination"
  fi

  if [[ $# -eq 2 ]]; then
    src=$(expand_group_path "$1")
    dest=$(expand_group_path "$2")
    mv_group "$src" "$dest"
    exit
  fi

  dest=$(expand_group_path "${!#}")
  if [[ ! -e "$dest" ]]; then
    mkdir -p "$dest" ||
      perror "Couldn't create ${!#}"
  fi
  if [[ ! -d "$dest" ]]; then
    perror "${!#} is not a directory"
  fi

  set -- "${@:1:$#-1}"
  while [[ $# -gt 0 ]]; do
    src=$(expand_group_path "$1")
    mv_group "$src" "$dest" ||
      exit_code=1
    shift
  done

  exit $exit_code
}

function command_chattr()
{
  local failure_cnt=0
  local expect_file=""
  local line attribute file
  shift

  # Collect attributes and files from command line
  local attributes=()
  local files=()
  while [[ $# -gt 0 ]]; do
    [[ $# -eq 1 ]] && expect_file="yes"
    if [[ "$expect_file" == "yes" ]]; then
      files+=("$1")
    elif [[ "$1" == "--" ]]; then
      expect_file="yes"
    else
      attributes+=("$1")
    fi
    shift
  done

  if (( ${#attributes[@]} == 0 )) ||
     (( ${#files[@]} == 0 )); then
    perror "chattr: must specify at least one attribute and one file"
  fi

  # Prepare list of files
  local i
  for i in "${!files[@]}"; do
    local path=$(get_cli_arg_as_repository_path "${files[i]}")

    if [[ "$path" == "$REPOSITORY_DIR/Groups/"* ]]; then
      if [[ -h "$path" ]]; then
	path="$(realpath -- $path)"
      else
	perror "${path/#$REPOSITORY_DIR\/Groups\//:}: can't set attribute"
	return 1
      fi
    fi

    if [[ ! -e "$path" ]]; then
      perror "${files[i]} does not exist in repository" non-fatal
      unset 'files[i]'
      (( ++failure_cnt ))
      continue
    fi

    if [[ -d "$path" ]]; then
      path=$path/.chez_test_gitattributes
    fi

    files[i]="$path"
  done

  # Prepare attributes
  local attr value a
  declare -A attribute_map
  for i in "${!attributes[@]}"; do
    a=${attributes[i]}
    attr=${a#+}
    attr=${attr#-}
    attr=${attr%%=*}
    if [[ "$a" == +* ]]; then
      value="set"
    elif [[ "$a" == -* ]]; then
      value="unset"
    elif [[ "$a" == *=* ]]; then
      value=${a#*=}
    else
      value="set"
    fi
    attribute_map[$attr]="$value"
  done

  if (( ${#attributes[@]} == 0 )) ||
     (( ${#files[@]} == 0 )); then
    exit 1
  fi

  git -C "${REPOSITORY_DIR}" check-attr "${!attribute_map[@]}" -- "${files[@]}" |
  while IFS=: read -r line; do
    # Split the line into fields using ':' as delimiter
    value="${line##*: }"
    line="${line%:*}"
    attribute="${line##*: }"
    file="${line%:*}"
    if [[ "${attribute_map[$attribute]}" == "$value" ]] ||
       [[ "${attribute_map[$attribute]}" == "unset"  &&
          "$value" == "unspecified" ]]; then
      verbose_message "$file: $attribute already set to ${attribute_map[$attribute]}"
    else
      verbose_message "$file: setting $attribute to ${attribute_map[$attribute]}"
      if [[ "$option_dry_run" != "yes" ]]; then
	case "${attribute_map[$attribute]}" in
	  set)   value="$attribute"    ;;
	  unset) value="-$attribute"   ;;
	  *)     value="$attribute=${attribute_map[$attribute]}" ;;
	esac
	if [[ "$file" == */.chez_test_gitattributes ]]; then
          echo "* $value" >> "${file%/*}/.gitattributes"
	else
          echo "/${file##*/} $value" >> "${file%/*}/.gitattributes"
	fi
        git -C "${REPOSITORY_DIR}" add "${file%/*}/.gitattributes"
      fi
    fi
  done

  (( failure_cnt == 0 ))
  exit
}

function is_deferred_set_for()
{
  local path=$1

  if [[ -d "$path" ]]; then
    path=$path/.chez_test_gitattributes
  fi

  [[ "$(git -C "${REPOSITORY_DIR}" check-attr deferred -- "$path")" == *": deferred: set" ]]
}

function prompt_user_whether_to_overwrite()
{
  [[ "$connected_to_terminal" == "no" ]] && return 1
  local response
  while true; do
    echo -n "$2 already exists. Overwrite? [y,n,q,d,a]: " > /dev/tty
    read -r response < /dev/tty
    case "$response" in
      y) return 0 ;;
      n) return 1 ;;
      q) exit 1   ;;
      d) git diff --no-index "$1" "$2" ;;
      a) user_override_overwrite="always"
         return 0 ;;
    esac
  done
}

function is_overwrite_allowed()
{
  [[ "$user_override_overwrite" == "always" ]] && return 0;

  case "$option_overwrite" in
    yes) ;&
    always) return 0 ;;
    prompt) prompt_user_whether_to_overwrite "$1" "$2" ;;
    *) return 1;;
  esac
}

function apply_single_file()
{
  local destination=$(repository_to_system "$1")
  local display_name=${1#$REPOSITORY_DIR/Files/}

  if [[ ! -z "$defer_mechanism_activated" && "$option_deferred" == "yes" ]]; then
    # skipping this file: deferred
    return 0
  fi

  if [[ -e "$destination" ]]; then
    if ! is_overwrite_allowed "$1" "$destination"; then
      echo "Skipping $display_name: already exist"
      return 0
    fi
  fi

  local sudo_prefix="" sudo_message=""
  if [[ "$option_sudo" == "yes" ]]; then
    sudo_prefix="sudo"
    sudo_message="with sudo"
  fi

  if [[ ! -z "$option_exec" ]]; then
    verbose_message "Executing $display_name with $option_exec"
    if [[ ! -x "$1" ]]; then
      chmod +x "$1" ||
      {
	perror "$display_name: not executable" non-fatal
	return 1
      }
    fi
    is_this_a_dry_run ||
    case "$option_exec" in
      template) ;&
      yes) $sudo_prefix "$1" > "$destination" ;;
      modify)
	if [[ -f "$destination" ]]; then
	  $sudo_prefix "$1" < "$destination" | sponge "$destination"
	else
	  $sudo_prefix "$1" < /dev/null > "$destination"
	fi ;;
      no-output) $sudo_prefix "$1" ;;
      *) perror "$option_exec: unknown exec option" non-fatal
	 return 1
    esac
    return
  elif [[ "$option_link" == "yes" ]]; then
    local link_target
    IFS= read -r link_target < "$1" || return 1
    verbose_message "Linking $link_target to $destination $sudo_message"
    is_this_a_dry_run ||
    $sudo_prefix ln -sfn "$link_target" "$destination" || return 1
  elif [[ "$option_symbolic" == "yes" ]]; then
    verbose_message "Linking $display_name to $destination $sudo_message"
    is_this_a_dry_run ||
    $sudo_prefix ln -sfn "$1" "$destination" || return 1
  else
    verbose_message "Copying $display_name to $destination $sudo_message"
    is_this_a_dry_run ||
    $sudo_prefix cp "$1" "$destination" || return 1
  fi

  if [[ ! -z "$option_permission" ]]; then
    verbose_message "Changing permission of file to $option_permission"
    is_this_a_dry_run ||
    $sudo_prefix chmod "$option_permission" "$destination" || return 1
  fi

  if [[ ! -z "$option_owner" ]]; then
    verbose_message "Changing owner of file to ${option_owner//+/:}"
    is_this_a_dry_run ||
    $sudo_prefix chown "${option_owner//+/:}" "$destination"
  fi
}

function apply_single_path()
{
  local exit_code
  local expanded_path
  if ! expanded_path="$(get_cli_arg_as_repository_path "$1")"; then
    perror "$1 does not exist in repository" non-fatal
    return 1
  fi

  user_override_overwrite=""

  verbose_message "Applying $1..."
  if [[ "$expanded_path" == "$REPOSITORY_DIR/Groups/"* ]]; then
    if [[ -d "$expanded_path" ]]; then
      for_each_found_file_with_options_slurped_do apply_single_file "$expanded_path" -type l -exec readlink -f {} +
    elif [[ -h "$expanded_path" ]]; then
      for_each_found_file_with_options_slurped_do apply_single_file "$(realpath -- $expanded_path)"
    else
      perror "$1 is not a file that can be applied" non-fatal
      return 1
    fi
  else
    if [[ "$option_all" != "yes" ]] && ! is_deferred_set_for "$expanded_path"; then
      local defer_mechanism_activated="yes"
    fi
    for_each_found_file_with_options_slurped_do apply_single_file "$expanded_path" -type f
  fi

  exit_code=$?
  if [[ -z "$keep_the_same_filters" ]]; then
    filters=()
    negations=()
  fi
  return $exit_code
}

function command_apply()
{
  local option_symbolic=""
  local option_overwrite=""
  local option_sudo=""
  local option_force=""
  local option_all=""
  local option_permission=""
  local option_owner=""
  local option_link=""
  local option_exec=""
  local success_cnt=0 failure_cnt=0

  declare -A filters negations
  local excludes=()
  local keep_the_same_filters=""
  collect_exclude_options "$@"

  local filter_value_plus="yes"
  local filter_value_minus=""

  shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-s" ]]; then
      option_symbolic="yes"
    elif [[ "$1" == "-c" || "$1" == "--copy" ]]; then
      option_symbolic="no"
    elif [[ "$1" == "-a" || "$1" == "--all" ]]; then
      option_all="yes"
    elif [[ "$1" == "-f" || "$1" == "--force" ]]; then
      option_force="yes"
    elif [[ "$1" == "-o" || "$1" == "--overwrite" ]]; then
      option_overwrite="yes"
    elif [[ "$1" == "-op" || "$1" == "--overwrite=prompt" ]]; then
      option_overwrite="prompt"
    elif [[ "$1" == "--overwrite=always" ]]; then
      option_overwrite="always"
    elif [[ "$1" == "--overwrite=never" ]]; then
      option_overwrite="never"
    elif [[ "$1" == "--sudo" ]]; then
      option_sudo="yes"
    elif [[ "$1" == "--nosudo" ]]; then
      option_sudo="no"
    elif [[ "$1" == "-v" || "$1" == "--verbose" ]]; then
      option_verbose="yes"
    elif [[ "$1" == "-n" || "$1" == "--dry-run" ]]; then
      option_dry_run="yes"
    elif [[ "$1" == "--filter" ]]; then
      shift
      add_filter "$1"
    elif [[ "$1" == "--exclude" ]]; then
      shift
    elif [[ "$1" == "-g" || "$1" == "--global" ]]; then
      keep_the_same_filters="yes"
    elif [[ "$1" != -* ]]; then
      apply_single_path "$1" && (( ++success_cnt )) || (( ++failure_cnt ))
    else
      perror "unknown option $1"
    fi
    shift
  done

  if (( $success_cnt == 0 )) && (( $failure_cnt == 0 )); then
    apply_single_path "${REPOSITORY_DIR}/Files"
  elif (( $failure_cnt > 0 && $failure_cnt+$success_cnt > 1)); then
    echo "$((success_cnt+failure_cnt)) paths applied: $success_cnt success(es), $failure_cnt failure(s)"
  fi

  (( failure_cnt == 0 ))
  exit $?
}

function command_apply_check_options()
{
  expanded_arguments=("$1")
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s) ;&
      -c) ;&
      -a|--all) ;&
      -o|--overwrite) ;&
      --overwrite=always) ;&
      --overwrite=never)  ;&
      --overwrite=prompt|-op) ;&
      -v|--verbose) ;&
      -n|--dry_run) ;&
      --sudo)   ;&
      --nosudo) ;&
      -g|--global)  ;&
      -f|--force) : ;;
      --filter)
	expanded_arguments+=("$1")
	shift ;;
      --exclude)
	expanded_arguments+=("$1")
	shift ;;
      *)
        if [[ "$1" == -* ]]; then
	  if [[ "$1" == -[^-][^-]* ]]; then
	    for (( i=1; i<${#1}; i++ )); do
	      expanded_arguments+=("-${1:i:1}")
	    done
	    shift ; continue
	  else
	    perror "unknown option $1"
	  fi
	fi ;;
    esac
    expanded_arguments+=("$1")
    shift
  done
}

function ensure_repository_exists()
{
  if [[ ! -d "$REPOSITORY_DIR/.git" ]]; then
    verbose_message "Creating initial repository at $REPOSITORY_DIR"
    mkdir -p "$REPOSITORY_DIR" ||
      perror "Error creating repository directory $REPOSITORY_DIR"
    (cd "$REPOSITORY_DIR"
     mkdir -p Files
     mkdir -p Groups
     touch Files/.gitkeep Groups/.gitkeep
     git init
     echo "Chez v0.1 source repository" > .git/description
     git add Files/.gitkeep Groups/.gitkeep
     git commit -m "Initiating repository")
  fi
}

function perror_file_points_to_repository()
{
  echo "'$1' points into or is in the repository."
  # TODO: After implementing conversion to repository filename
  # add a warning "This link is not managed by Chez" if the
  # link target does not correspond to source file.
}

function find_group_basedir_for_file()
{
  local file_directory=${1%/*}

  if [[ ! -e "${REPOSITORY_DIR}/Groups/$group" ]]; then
    _group_basedir_path=${REPOSITORY_DIR}/Groups/$group
    _group_basedir_base=$file_directory
    return 0
  fi

  if [[ -e "${REPOSITORY_DIR}/Groups/$group" &&
      ! -d "${REPOSITORY_DIR}/Groups/$group" ]]; then
    perror "Groups/$group is not a directory" non-fatal
    return 1
  fi

  local basedir_file base
  local match_location=""
  local group_path=${REPOSITORY_DIR}/Groups/${group}
  while IFS= read -r -d '' basedir_file; do
    read base < "$basedir_file"
    if [[ "$file_directory/" == "$base"/* ]]; then
      if [[ -z "$match_location" ]] ||
	 [[ "${#base}" -gt "${#match_base}" ]]; then
        match_location="${basedir_file%/*}"
	match_base="$base"
      fi
    fi
  done < <(find "$group_path" -name .chezgroupbasedir -print0)

  if [[ -z "$match_location" ]]; then
    _group_basedir_path=$group_path
    _group_basedir_base=$file_directory
  else
    _group_basedir_path=$match_location
    _group_basedir_base=$match_base
  fi
}

function link_file_into_the_group()
{
  if [[ ! -z "$group_basedir_path" ]]; then
    local link_name=${group_basedir_path}${1#"$group_basedir_base"}
    verbose_message "Linking $link_name to $1"
    is_this_a_dry_run ||
    {
      mkdir -p "${link_name%/*}" &&
      ln -srfn "${REPOSITORY_DIR}/Files$1" "$link_name"
    }
  else
    find_group_basedir_for_file "$1" || return 1
    local link_name=${_group_basedir_path}${1#"$_group_basedir_base"}
    verbose_message "Linking $link_name to $1"
    is_this_a_dry_run ||
    {
      mkdir -p "${link_name%/*}"
      ln -srfn "${REPOSITORY_DIR}/Files$1" "$link_name"
    }
  fi
}

function make_space_for_another_group()
{
  local group_path="$REPOSITORY_DIR/Groups/$group"
  local counter=0
  local subdir_name=${basedir##*/}
  while [[ -e "$group_path/$subdir_name" ]]; do
    (( ++counter ))
    subdir_name="${basedir##*/}($counter)"
    if [[ $counter -gt 128 ]]; then
      return 1
    fi
  done

  local exit_code=0
  mkdir "$group_path/$subdir_name" || return 1
  for_each_found_file_do update_source_link_for_mv "$group_path" -type l
  find "$group_path" -maxdepth 1 -mindepth 1 ! -name "$subdir_name" \
       -exec mv -t "$group_path/$subdir_name" {} + || exit_code=1
  for_each_found_file_do update_dest_link_for_mv "$group_path" -type l
  return $exit_code
}

function find_group_basedir()
{
  # Ensure $group is not already linked somewhere
  local path=/$group
  local path=${path%/*}
  while [[ ! -z "$path" ]]; do
    if [[ -e "${REPOSITORY_DIR}/Groups${path}/.chezgroupbasedir" ]]; then
      perror "${path#/} is already linked to $(cat ${REPOSITORY_DIR}/Groups${path}/.chezgroupbasedir)" non-fatal
      return 1
    fi
    path=${path%/*}
  done

  if [[ ! -e "${REPOSITORY_DIR}/Groups/$group" ]]; then
    is_this_a_dry_run ||
    { verbose_message "Creating group $group"
      mkdir -p "${REPOSITORY_DIR}/Groups/$group" ||
      {
	perror "Couldn't create group '$group'" non-fatal
	return 1
      }
    echo "$1" > "${REPOSITORY_DIR}/Groups/$group/.chezgroupbasedir"; }
    _group_basedir_path=${REPOSITORY_DIR}/Groups/$group
    _group_basedir_base=$1
    return 0
  fi

  if [[ -e "${REPOSITORY_DIR}/Groups/$group" &&
      ! -d "${REPOSITORY_DIR}/Groups/$group" ]]; then
    perror "Groups/$group is not a directory" non-fatal
    return 1
  fi

  if [[ -z "$(ls -A "${REPOSITORY_DIR}/Groups/$group")" ]]; then
    is_this_a_dry_run ||
    echo "$1" > "${REPOSITORY_DIR}/Groups/$group/.chezgroupbasedir"
    _group_basedir_path=${REPOSITORY_DIR}/Groups/$group
    _group_basedir_base=$1
    return 0
  fi

  if [[ -e "${REPOSITORY_DIR}/Groups/$group/.chezgroupbasedir" ]]; then
   local basedir
   read basedir < "${REPOSITORY_DIR}/Groups/$group/.chezgroupbasedir"
   if [[ "$1/" != "$basedir"/* ]]; then
     verbose_message "Moving $1 into subdirectory"
     make_space_for_another_group "$1" ||
       {
	 perror "Failed to move content of '$group'"
	 return 1
       }
   fi
  fi

  local file base number_of_matches=0
  local merge_location=""
  local match_location=""
  local group_path=${REPOSITORY_DIR}/Groups/${group}
  while IFS= read -r -d '' file; do
    read base < "$file"
    if [[ "$1/" == "$base"/* ]]; then
      if [[ -z "$match_location" ]] ||
	 [[ "${#base}" -gt "${#match_base}" ]]; then
        match_location="${file%/*}"
	match_base="$base"
      fi
      (( ++number_of_matches ))
    elif [[ "$base/" == "$1"/* ]]; then
      merge_location="${file%/*}"
      merge_base="$base"
      (( ++number_of_matches ))
    fi
  done < <(find "$group_path" -name .chezgroupbasedir -print0)

  if [[ -z "$match_location" ]]; then
    is_this_a_dry_run ||
    { mkdir "$group_path/${1##*/}" ||
      {
	perror "Couldnt create '$group_path/${1##*/}'" non-fatal
	return 1
      }
      echo "$1" > "$group_path/${1##*/}/.chezgroupbasedir"
    }
    _group_basedir_path=$group_path/${1##*/}
    _group_basedir_base=$1
  else
    _group_basedir_path=$match_location
    _group_basedir_base=$match_base
  fi
  return 0
}

function read_exclude_file()
{
  local file
  if [[ -f "$REPOSITORY_DIR/.chezignore" ]]; then
    excluded_files=()
    while IFS= read -r file; do
      if [[ "$file" == */* ]]; then
        excluded_files+=("!" "-path" "$file")
      else
	excluded_files+=("!" "-path" '*/$file')
      fi
    done
  fi
}

function is_sudo_necessary_for()
{
  if [[ "$option_symbolic" == "yes" ]]; then
    [[ ! -w "${1%/*}" ]]
  else
    [[ ! -w "$1" ]]
  fi
}

function add_file_to_repository()
{
  if [[ -L "$1" ]]; then
    if [[ "$option_follow_link" == "store-link" ]]; then
      destination_filename=$(system_to_repository "$1")
      destination_filename="${destination_filename%/*}/link_${destination_filename##*/}"
      verbose_message "Copying link $1 to repository"
      local link_target
      link_target="$(readlink $1)" &&
      echo "$link_target" > "${REPOSITORY_DIR}/Files${destination_filename}"
      return
    elif [[ "$option_follow_link" != "yes" ]]; then
      echo "Skipping $1: symbolic link."
      return 1
    fi
  fi

  if [[ -f "$1" ]]; then
    destination_filename=$(system_to_repository "$1")
    is_this_a_dry_run ||
    { mkdir -p "${REPOSITORY_DIR}/Files${destination_filename%/*}"
      cp "$1" "${REPOSITORY_DIR}/Files${destination_filename}" || return 1
      git -C "${REPOSITORY_DIR}" add "Files${destination_filename}"; }
    verbose_message "Copying $1 to repository"
    if [[ "$option_symbolic" == "yes" ]]; then
      is_this_a_dry_run ||
      { rm "$1"
        ln -s "${REPOSITORY_DIR}/Files${destination_filename}" "$1"; }
      verbose_message "Replacing $1 with symbolic link to repository"
    fi
    [[ -z "$group" ]] ||
      link_file_into_the_group "$destination_filename"
  elif [[ -d "$1" ]]; then
    if [[ ! -z "$group" ]]; then
      find_group_basedir "$(system_to_repository "$1")" || return 1
      local group_basedir_path=$_group_basedir_path
      local group_basedir_base=$_group_basedir_base
    fi
    read_exclude_file
    for_each_found_file_do add_file_to_repository "$1" -type f "${excluded_files[@]}"
  else
    echo "Skipping $1: special file."
    return 1
  fi

  if [[ -f "$1" ]] &&
     [[ -z "$option_sudo" ]] &&
     is_sudo_necessary_for "$1"; then
    option_sudo="yes"
    record_attributes_if_necessary "$1" "sudo"
    option_sudo=""
  fi

  if [[ -f "$1" ]] &&
     [[ "$automatic_permissions" == "yes" ]]; then
    local path="${REPOSITORY_DIR}/Files$(system_to_repository "$1")"
    echo "/${path##*/} permission=$(stat -c "%a" "$1")" >> "${path%/*}/.gitattributes"
  fi

  return 0
}

function record_attributes_if_necessary()
{
  local attribute
  local relevant_attributes=(symbolic sudo deferred test)
  local path="${REPOSITORY_DIR}/Files$(system_to_repository "$1")"

  [[ -z "$option_sudo" ]] &&
  remove_element_from_array relevant_attributes "sudo"

  [[ -z "$2" ]] ||
  local relevant_attributes=($2)

  if [[ -d "$path" ]]; then
    path=$path/.chez_test_gitattributes
  fi

  git -C "${REPOSITORY_DIR}" check-attr "${relevant_attributes[@]}" -- $path |
  cut -d: -f2- |
  while IFS=: read -r attribute value; do
    option_value="option_${attribute# }"
    if [[ "$value" == " set" && "${!option_value}" != "yes" ]] ||
       [[ "$value" != " set" && "${!option_value}" == "yes" ]]; then
      [[ "$value" == " set" ]] && sign_prefix="-" || sign_prefix=""
      verbose_message "Recording attribute $sign_prefix${attribute# } for ${path%.chez_test_gitattributes}"
      if [[ "$option_dry_run" != "yes" ]]; then
        if [[ -d "$1" ]]; then
          echo "* $sign_prefix${attribute# }" >> "${path%/*}/.gitattributes"
        else
          echo "/${path##*/} $sign_prefix${attribute# }" >> "${path%/*}/.gitattributes"
        fi
        git -C "${REPOSITORY_DIR}" add "${path%/*}/.gitattributes"
      fi
    fi
  done
}

function add_single_path()
{
  ensure_repository_exists

  # Report error if no path specified
  if [[ -z "$1" ]]; then
    perror "No path specified!" non-fatal
    return 1
  fi

  # Report error if file is in the repository or doesn't exists
  if [[ "$(realpath -- "$1")" == "${REPOSITORY_DIR}"* ]]; then
    perror_file_points_to_repository "$1"
    return 1
  fi

  if [[ ! -e "$1" ]]; then
    perror "'$1' does not exists." non-fatal
    return 1
  fi

  if [[ ! -r "$1" ]]; then
    perror "'$1' is not readable." non-fatal
    return 1
  fi

  local saved_option_sudo=$option_sudo
  local absolute_path=$(realpath -s -- "$1")
  verbose_message "Adding $absolute_path to repository..."
  add_file_to_repository "$absolute_path" &&
  record_attributes_if_necessary "$absolute_path"
  option_sudo=$saved_option_sudo
  return $?
}

function command_add()
{
  local option_symbolic=""
  local option_sudo=""
  local option_deferred=""
  local automatic_permissions=""
  local group=""
  local success_cnt=0 failure_cnt=0

  # Parse command line arguments
  shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-s" ]]; then
      option_symbolic="yes"
    elif [[ "$1" == "-c" || "$1" == "--copy" ]]; then
      option_symbolic="no"
    elif [[ "$1" == "--sudo" ]]; then
      option_sudo="yes"
    elif [[ "$1" == "--nosudo" ]]; then
      option_sudo="no"
    elif [[ "$1" == "--store-link" || "$1" == "--link" ]]; then
      option_follow_link="store-link"
    elif [[ "$1" == "-L" || "$1" == "--follow-link" ]]; then
      option_follow_link="yes"
    elif [[ "$1" == "--permission" ]]; then
      automatic_permissions="yes"
    elif [[ "$1" == "-v" || "$1" == "--verbose" ]]; then
      option_verbose="yes"
    elif [[ "$1" == "-n" || "$1" == "--dry-run" ]]; then
      option_dry_run="yes"
    elif [[ "$1" == "--defer" ]]; then
      option_deferred="yes"
    elif [[ "$1" == "-g" || "$1" == "--group" ]]; then
      shift
      if [[ -z "$1" || "$1" == -* ]]; then
        perror "option -g is missing required argument"
      else
        group=${1%/}
      fi
    elif [[ "$1" != -* ]]; then
      add_single_path "$1" && (( ++success_cnt )) || (( ++failure_cnt ))
    else
      perror "unknown option $1"
    fi
    shift
  done

  if (( $success_cnt == 0 )) && (( $failure_cnt == 0 )); then
    perror "no path specified!"
  elif (( $failure_cnt > 0 && $failure_cnt+$success_cnt > 1)); then
    echo "$((success_cnt+failure_cnt)) paths processed: $success_cnt success(es), $failure_cnt failure(s)"
  fi                                       #
                                           #
  (( failure_cnt == 0 ))
  exit $?
}

function command_add_check_options()
{
  expanded_arguments=("$1")
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -g|--group)
	expanded_arguments+=("$1")
        shift
	if [[ -z "$1" || "$1" == -* ]]; then
          perror "option -g is missing required argument"
	fi ;;
      -s) ;&
      -c) ;&
      -v|--verbose) ;&
      -n|--dry-run) ;&
      --sudo)   ;&
      --nosudo) ;&
      --defer)  ;&
      --permission) ;&
      --store-link|--link) ;&
      -L|--follow-link) : ;;
      *)
        if [[ "$1" == -* ]]; then
	  if [[ "$1" == -[^-][^-]* ]]; then
	    for (( i=1; i<${#1}; i++ )); do
	      expanded_arguments+=("-${1:i:1}")
	    done
	    shift ; continue
	  else
	    perror "unknown option $1"
	  fi
	fi ;;
    esac
    expanded_arguments+=("$1")
    shift
  done
}

function perror_unknown_option_or_command()
{
  if [[ "$1" == -* ]]; then
    echo "$arg0: Unknown option $1."
  else
    echo "$arg0: Unknown command $1."
  fi
  exit 1
}

option_follow_link=""
option_verbose=""
option_dry_run=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      usage   ;;
    --version)
      version ;;
    -v|--verbose)
      option_verbose="yes" ;;
    -n|--dry-run)
      option_dry_run="yes" ;;
    --store-link|--link)
      option_follow_link="store-link" ;;
    -L|--follow-link)
      option_follow_link="yes" ;;
    add)
      command_add_check_options "$@"
      set -- "${expanded_arguments[@]}"
      command_add "$@"    ;;
    apply)
      command_apply_check_options "$@"
      set -- "${expanded_arguments[@]}"
      command_apply "$@"  ;;
    diff)
      command_diff "$@" |
      invoke_pager_if_on_terminal
      exit                ;;
    git)
      shift
      command_git "$@"    ;;
    status) ;&
    commit)
      command_git "$@"    ;;
    chattr)
      command_chattr "$@" ;;
    mv)
      command_mv "$@"     ;;
    cd)
      command_cd "$@"     ;;
    get-repository-path)
      command_get_repository_path "$@"       ;;
    ls-files)
      command_ls-files "$@" ;;
    edit)
      command_edit "$@"     ;;
    *) perror_unknown_option_or_command "$1" ;;
  esac
  shift
done

